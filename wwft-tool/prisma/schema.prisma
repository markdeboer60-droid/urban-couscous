// Wwft Compliance Tool — Prisma Schema
// SQLite (migratable to PostgreSQL via datasource swap)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  MEDEWERKER
  PARTNER
}

enum RisicoOordeel {
  LAAG
  MIDDEN
  HOOG
}

enum ClientStatus {
  GESTART
  IN_BEHANDELING
  AFGEROND
  BEEINDIGD
}

enum WizardStap {
  BEDRIJFSVERKENNING
  WWFT
  IDENTIFICATIE
  BEOORDELING
}

enum WizardAntwoord {
  JA
  NEE
  NVT
}

enum DocumentType {
  ID
  UBO
  KVK
  UBO_REGISTER
  OVERIG
}

enum ReviewStatus {
  GEPLAND
  UITGEVOERD
  ACHTERSTALLIG
}

enum MeldingBeslissing {
  NIET_MELDEN
  FIU_MELDING
}

enum IndicatorType {
  SUBJECTIEF
  OBJECTIEF
}

enum ZoekBron {
  OPENSANCTIONS
  WEBSEARCH
  GLEIF
  ICIJ
}

enum SearchBeslissing {
  RISICO
  FALSE_POSITIVE
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Organization {
  id         String   @id @default(cuid())
  naam       String
  kvkNummer  String?
  aangemaakt DateTime @default(now())

  users    User[]
  clients  Client[]
  settings OrganizationSettings?
  notificaties Notificatie[]
}

model OrganizationSettings {
  id                   String    @id @default(cuid())
  organizationId       String    @unique
  monitoringFrequentie String    @default("WEKELIJKS") // DAGELIJKS | WEKELIJKS
  monitoringTijdstip   String    @default("08:00")     // HH:MM UTC
  monitoringDagVanWeek Int       @default(1)            // 1=ma…7=zo
  volgendeMonitoringRun DateTime?
  emailNotificaties    Boolean   @default(true)
  appNotificaties      Boolean   @default(true)

  organization Organization @relation(fields: [organizationId], references: [id])
}

model Notificatie {
  id             String   @id @default(cuid())
  organizationId String
  type           String   // MONITORING_ALERT | REVIEW_DUE | HOOG_RISICO
  titel          String
  bericht        String
  clientId       String?
  gelezen        Boolean  @default(false)
  gelezenOp      DateTime?
  aangemaakt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  email          String   @unique
  wachtwoordHash String
  naam           String
  rol            UserRole @default(MEDEWERKER)
  totpSecret     String?
  totpEnabled    Boolean  @default(false)

  organization Organization @relation(fields: [organizationId], references: [id])

  clientsAangemaakt    Client[]             @relation("ClientAangemaakt")
  clientsGoedgekeurd   Client[]             @relation("ClientGoedgekeurd")
  clientsEddGoedgekeurd Client[]            @relation("ClientEddGoedgekeurd")
  clientsBeeindigd     Client[]             @relation("ClientBeeindigd")
  searchQueries        SearchQuery[]
  searchActions        SearchResultAction[]
  documenten           Document[]
  reviews              Review[]
  meldingen            Melding[]
  opmerkingen          Opmerking[]
}

model Client {
  id               String         @id @default(cuid())
  organizationId   String
  naam             String
  kvkNummer        String?
  land             String?
  risicoOordeel    RisicoOordeel?
  risicoMotivatie  String?
  status           ClientStatus   @default(GESTART)
  aangemaakt       DateTime       @default(now())
  aangemaaktDoor   String
  goedgekeurdDoor  String?
  goedgekeurdOp    DateTime?
  eindOpmerkingen  String?
  // EDD
  isEdd            Boolean        @default(false)
  eddBronVermogen  String?
  eddGoedgekeurdDoor String?
  eddGoedgekeurdOp   DateTime?
  // Beëindiging
  beeindigd        DateTime?
  beeindigdReden   String?
  beeindigdDoor    String?
  verwijderDatum   DateTime?
  // Monitoring
  lastScreenedOp   DateTime?
  kvkSnapshot      String?   // JSON snapshot for change detection

  organization         Organization @relation(fields: [organizationId], references: [id])
  aanmaker             User         @relation("ClientAangemaakt", fields: [aangemaaktDoor], references: [id])
  goedgekeurdeUser     User?        @relation("ClientGoedgekeurd", fields: [goedgekeurdDoor], references: [id])
  eddGoedgekeurdeUser  User?        @relation("ClientEddGoedgekeurd", fields: [eddGoedgekeurdDoor], references: [id])
  beeindigdeUser       User?        @relation("ClientBeeindigd", fields: [beeindigdDoor], references: [id])

  wizardAnswers     WizardAnswer[]
  documents         Document[]
  reviews           Review[]
  meldingen         Melding[]
  searchQueries     SearchQuery[]
  monitoringAlerts  MonitoringAlert[]
  uboNodes          UboNode[]
  uboEdges          UboEdge[]
  notificaties      Notificatie[]
  opmerkingen       Opmerking[]
}

model WizardAnswer {
  id          String         @id @default(cuid())
  clientId    String
  stap        WizardStap
  vraagKey    String
  antwoord    WizardAntwoord
  toelichting String?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, vraagKey])
}

model Document {
  id                 String       @id @default(cuid())
  clientId           String
  type               DocumentType
  bestandsnaam       String
  bestandspad        String
  naamBetrokkene     String?
  functie            String?
  geboortedatum      String?
  verificatiemethode String?
  isPep              Boolean      @default(false)
  pepBronVermelding  String?
  uploadOp           DateTime     @default(now())
  uploadDoor         String

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  uploader User   @relation(fields: [uploadDoor], references: [id])
}

model Review {
  id               String         @id @default(cuid())
  clientId         String
  uitgevoerdOp     DateTime?
  uitgevoerdDoor   String?
  volgendeReviewOp DateTime
  status           ReviewStatus   @default(GEPLAND)
  bevindingen      String?
  risicoOordeelNa  RisicoOordeel?
  emailVerstuurd   Boolean        @default(false)

  client     Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  uitvoerder User?  @relation(fields: [uitgevoerdDoor], references: [id])
}

model Melding {
  id              String            @id @default(cuid())
  clientId        String
  datumTransactie DateTime
  bedrag          Float
  omschrijving    String
  indicatorType   IndicatorType
  motivatie       String
  beslissing      MeldingBeslissing
  onderbouwing    String
  afgerondDoor    String?
  afgerondOp      DateTime?
  fiuReferentie   String?

  client         Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  afgerondByUser User?  @relation(fields: [afgerondDoor], references: [id])
}

model SearchQuery {
  id             String   @id @default(cuid())
  clientId       String
  zoeknaam       String
  bron           ZoekBron
  uitgevoerdOp   DateTime @default(now())
  uitgevoerdDoor String

  client     Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  uitvoerder User   @relation(fields: [uitgevoerdDoor], references: [id])

  resultActions SearchResultAction[]
}

model SearchResultAction {
  id              String           @id @default(cuid())
  searchQueryId   String
  hitTitel        String
  hitUrl          String?
  hitSamenvatting String
  beslissing      SearchBeslissing
  notitie         String?
  timestamp       DateTime         @default(now())
  gebruikerId     String

  searchQuery SearchQuery @relation(fields: [searchQueryId], references: [id], onDelete: Cascade)
  gebruiker   User        @relation(fields: [gebruikerId], references: [id])
}

model MonitoringAlert {
  id           String    @id @default(cuid())
  clientId     String
  type         String    // SANCTIONS_HIT | KVK_INACTIEF | KVK_FAILLIET
  bron         String    // OPENSANCTIONS | KVK_OPENDATA
  omschrijving String
  aangemaakt   DateTime  @default(now())
  opgelost     Boolean   @default(false)
  opgelostOp   DateTime?
  opgelostDoor String?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model UboNode {
  id            String   @id @default(cuid())
  clientId      String
  type          String   // BEDRIJF | PERSOON
  naam          String
  kvkNummer     String?
  geboortedatum String?
  land          String?
  isPep         Boolean  @default(false)
  notities      String?
  posX          Float    @default(0)
  posY          Float    @default(0)
  aangemaakt    DateTime @default(now())

  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  uitgandeEdges  UboEdge[] @relation("EdgeVan")
  inkomstigeEdges UboEdge[] @relation("EdgeNaar")
}

model UboEdge {
  id       String  @id @default(cuid())
  clientId String
  vanId    String
  naarId   String
  type     String? // eigenaar | bestuurder | gevolmachtigde
  belang   Float?

  client Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  van    UboNode @relation("EdgeVan", fields: [vanId], references: [id], onDelete: Cascade)
  naar   UboNode @relation("EdgeNaar", fields: [naarId], references: [id], onDelete: Cascade)
}

model Opmerking {
  id         String   @id @default(cuid())
  clientId   String
  userId     String
  tekst      String
  aangemaakt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])
}
