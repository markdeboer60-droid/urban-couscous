{
  "name": "sjablonenplatform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "electron:dev": "node scripts/bundle-electron.mjs && NODE_ENV=development electron .",
    "build": "vite build",
    "electron:build": "node scripts/bundle-electron.mjs && vite build && electron-builder",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "build": {
    "appId": "nl.ottovisser.sjablonenplatform",
    "productName": "Sjabloongenerator",
    "copyright": "© 2025 Otto Visser & Partners",
    "icon": "build/icon",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "electron/**",
      "node_modules/pizzip/**",
      "node_modules/docxtemplater/**",
      "node_modules/pdf-lib/**",
      "node_modules/@pdf-lib/**",
      "node_modules/pako/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "Sjabloongenerator-Setup-${version}.exe",
      "requestedExecutionLevel": "user"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sjabloongenerator",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "directories": {
      "buildResources": "build",
      "output": "release"
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "cors": "^2.8.6",
    "docxtemplater": "^3.68.3",
    "docxtemplater-image-module-free": "^1.1.1",
    "express": "^5.2.1",
    "lucide-react": "^1.7.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pizzip": "^3.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.1"
  }
}
