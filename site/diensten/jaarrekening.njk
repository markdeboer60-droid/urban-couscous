          <li style="display:flex; gap:1rem; align-items:flex-start;">
            <span style="flex-shrink:0; width:2rem; height:2rem; border-radius:50%; background:var(--mediumblue); color:#fff; font-weight:700; font-size:0.875rem; display:flex; align-items:center; justify-content:center;">3</span>
