{% block content %}

{% set breadcrumbs = [{ "name": "Contact" }] %}
{% include "partials/breadcrumb.njk" %}

<section class="page-hero">
  <div class="container">
    <h1>Kennis maken met Otto Visser &amp; Partners</h1>
    <p class="page-intro">Heb je een vraag of wil je kennismaken? Bel ons, stuur een e-mail of vul het contactformulier in. We reageren altijd snel.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="contact-grid">

      <!-- Contact info -->
      <div class="contact-info">
        <h2>Onze gegevens</h2>

        <div class="contact-detail">
          <svg class="contact-detail-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <div>
            <strong>Bezoekadres</strong><br>
            Prinses Julianapark 7<br>
            8601 GJ Sneek
          </div>
        </div>

        <div class="contact-detail">
          <svg class="contact-detail-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13 19.79 19.79 0 0 1 1.56 4.36 2 2 0 0 1 3.53 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <div>
            <strong>Telefoon</strong><br>
            <a href="tel:+31515740810">0515 740 810</a>
          </div>
        </div>

        <div class="contact-detail">
          <svg class="contact-detail-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          <div>
            <strong>E-mail</strong><br>
            <a href="mailto:info@ottovisserpartners.nl">info@ottovisserpartners.nl</a>
          </div>
        </div>

        <div class="contact-detail">
          <svg class="contact-detail-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <div>
            <strong>Openingstijden</strong><br>
            Maandag t/m vrijdag: 08:30–17:30<br>
            Zaterdag &amp; zondag: gesloten
          </div>
        </div>

        <!-- Google Maps embed placeholder -->
        <div class="maps-embed">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2371.5!2d5.658!3d53.032!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2sPrinses%20Julianapark%207%2C%208601%20GJ%20Sneek!5e0!3m2!1snl!2snl!4v1234567890"
            width="600"
            height="300"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Locatie Otto Visser & Partners, Prinses Julianapark 7, Sneek"
          ></iframe>
        </div>
      </div>

      <!-- Contact form -->
      <div>
        <h2>Kennis maken</h2>

        <div id="form-success" class="form-success" role="alert">
          <strong>Bedankt voor je bericht!</strong> We nemen zo snel mogelijk contact met je op.
        </div>

        <form id="contact-form" novalidate aria-label="Contactformulier">
          <div class="form-group">
            <label for="naam">Naam</label>
            <input type="text" id="naam" name="naam" placeholder="Voornaam Achternaam" autocomplete="name" required>
            <div class="form-error" role="alert">Vul je naam in.</div>
          </div>

          <div class="form-group">
            <label for="bedrijf">Bedrijf</label>
            <input type="text" id="bedrijf" name="bedrijf" placeholder="Bedrijfsnaam" autocomplete="organization">
          </div>

          <div class="form-group">
            <label for="email">E-mail</label>
            <input type="email" id="email" name="email" placeholder="naam@bedrijf.nl" autocomplete="email" required>
            <div class="form-error" role="alert">Vul een geldig e-mailadres in.</div>
          </div>

          <div class="form-group">
            <label for="telefoon">Telefoon</label>
            <input type="tel" id="telefoon" name="telefoon" placeholder="+31 ..." autocomplete="tel">
          </div>

          <div class="form-group">
            <label for="bericht">Bericht <span style="color:var(--muted); font-weight:400">(optioneel)</span></label>
            <textarea id="bericht" name="bericht" placeholder="Waar wil je over sparren?"></textarea>
          </div>

          <button type="submit" class="btn btn-primary" style="width:100%; justify-content:center">
            Verstuur bericht
          </button>

          <p style="font-size:0.8rem; color:var(--muted); margin-top:0.75rem">
            We verwerken je gegevens conform ons <a href="/privacy/">privacybeleid</a>.
          </p>
        </form>
      </div>

    </div>
  </div>
</section>

{% endblock %}
